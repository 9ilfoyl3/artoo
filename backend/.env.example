# ============================================================
# Artoo 后端配置示例 —— 本地开发用
#
# 适用：make dev / 手动用 uvicorn 起后端（工作目录在 backend/，
#       pydantic 读取本文件同级的 .env）。
# 容器部署不读这里 —— 走根目录 .env.example（连接串由 compose 注入）。
#
# 复制为 backend/.env 后填写。注释项为内置默认值，需要时取消注释覆盖。
# ============================================================

# ===== 基础设施（本地直连 localhost；中间件由 make infra 启动）=====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/artoo
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Milvus 拓扑：共享 collection + kb_id/session_id 作为 Partition Key + 按维度分表。
# 物理表名 = <base>_<dim>，如 artoo_chunks_1024。知识库数量无上限（kb_id 只是标量 + 分桶键）。
# MILVUS_COLLECTION=artoo_chunks
# MILVUS_SESSION_COLLECTION=artoo_session_chunks
# 当前 embedding 维度（BGE-M3=1024）。换模型改这里并重建索引，旧维度表保留不影响。
# EMBED_DIM=1024
# 分区数不是知识库上限，只决定检索最少扫描比例（≈1/N）。建表时固定，改动需重建表。
# <5M 向量用 64；5M~50M 用 256；>50M 用 512~1024。
# MILVUS_NUM_PARTITIONS=64
# MILVUS_SESSION_NUM_PARTITIONS=16
# 写入分片数（建表固定，0=Milvus 默认）。高并发灌库可设 2~4，过大加重 MQ 压力。
# MILVUS_SHARDS_NUM=0
# 读副本数（LoadCollection 生效，可随时改）。>1 提升读吞吐但内存翻倍，单机保持 0。
# MILVUS_REPLICA_NUMBER=0
REDIS_URL=redis://localhost:6379/0

# ===== 对象存储 MinIO（知识库源文件权威存储；复用 Milvus 的 MinIO，独立 bucket）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=aladdin-documents
# 启动期对账孤儿对象的宽限期（秒）：仅删 last_modified 早于 now-该值 的无 DB 记录对象，
# 避免误删正在上传/建索引中的新对象。默认 3600（1 小时）。
MINIO_ORPHAN_GRACE_SECONDS=3600

# ===== 认证（必填，缺失则服务启动失败 fail-fast）=====
# JWT 签名密钥（HS256）。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# 初始超级管理员（首次启动自动创建，强制首次登录改密）
SUPER_ADMIN_USERNAME=root
SUPER_ADMIN_PASSWORD=ChangeMe#2024
# 注册模式：invite_only（默认，仅管理员/邀请建号）| self_serve（开放自助注册）
REGISTRATION_MODE=invite_only
# 超管业务内容可见边界：false（默认）= 超管不可查看业务内容正文
CONTENT_VIEW_BOUNDARY_OPEN=false

# ===== LLM（也可启动后在前端「模型管理」配置）=====
LLM_PROVIDER=vllm
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 单次输出上限；模型配置里的 max_output_tokens 优先。
LLM_MAX_OUTPUT_TOKENS=

# ===== Embedding 远程服务（填到 /v1，也可在前端配置）=====
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
# 是否启用 Sparse 向量（需服务支持 /embed_sparse 端点）
EMBED_SPARSE_ENABLED=true

# ===== Rerank 远程服务（也可在前端配置）=====
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# ===== 其余配置（OCR / 切片 / Agent）均有内置默认值 =====
# 需要调优时参考 backend/app/config.py，追加同名大写变量，例如：
# OCR_PROVIDER=external_api
# OCR_EXTERNAL_API_URL=http://your-ocr:8909/parse
# AGENT_MAX_ITERATIONS=10
# AGENT_TOOL_CALL_MAX_CONCURRENCY=4

# ============================================================
# 性能调优（按机器能力调整；不配则用下方默认值，本地默认偏保守）
# ============================================================
# 数据库连接池（每进程）：单进程上限 = POOL_SIZE + MAX_OVERFLOW
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 线程池（文档解析/切片、pymilvus 同步检索、bcrypt 等）。0 = Python 默认 min(32, CPU+4)
THREAD_POOL_MAX_WORKERS=0
# Worker 文档处理并发（本地单机建议小一些）
PIPELINE_MAX_CONCURRENT=4
PIPELINE_EMBED_CONCURRENCY=6
PIPELINE_EMBED_PER_DOC_CONCURRENCY=2
PIPELINE_EMBED_BATCH_SIZE=32
PIPELINE_EMBED_MAX_CONNECTIONS=20
PIPELINE_OCR_CONCURRENCY=4
PIPELINE_ASR_CONCURRENCY=2
PIPELINE_SLOW_LANE_MIN_MB=10
PIPELINE_SLOW_MAX_CONCURRENT=1

# ===== MCP（标准 Model Context Protocol，双向）=====
# 全部有内置默认值，通常无需配置。
# inbound（Artoo 作为 MCP server，端点 POST /mcp）：
# 单次工具调用最多并发检索的知识库数（不指定 knowledge_base_id 时的扇出上限）
# MCP_MAX_KB_FANOUT=8
# 每把 API Key 每分钟 tools/call 上限，0 = 关闭限流
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP 会话（Mcp-Session-Id）空闲过期秒数
# MCP_SESSION_TTL_SECONDS=3600
# outbound（Artoo 调用第三方 MCP server）：
# 是否禁止连接内网/环回地址的 MCP server。默认 false（内网部署是常态）；
# 无论如何 link-local（169.254.0.0/16 等云元数据端点）恒被阻断。
# MCP_BLOCK_PRIVATE_NETWORK=false
# MCP_CALL_TIMEOUT=60
# MCP_DISCOVERY_TIMEOUT=10

# ===== 知识图谱（knowledge-graph，默认整体关闭）=====
# 开启需：1) docker compose --profile infra --profile graph up -d 起 Neo4j
#         2) pip install -r requirements.txt -r requirements-graph.txt 装 neo4j 驱动
#         3) GRAPH_ENABLE=true
# 全局总开关：不为 true 则整体关闭图谱功能（不连 Neo4j、不抽取、API 返回明确不可用）
GRAPH_ENABLE=false
# Neo4j 连接（仅 GRAPH_ENABLE=true 时使用；本地开发直连 localhost 暴露的 7687）
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONN_TIMEOUT=5
# 单次图查询超时（秒），防恶意 depth/limit
GRAPH_QUERY_TIMEOUT=10
# 抽取慢道并发信号量上限（与文档入库 worker 物理隔离）
GRAPH_EXTRACT_CONCURRENCY=2
# 抽取子任务最大重试次数（超过进 DLQ）
GRAPH_EXTRACT_MAX_RETRIES=3
