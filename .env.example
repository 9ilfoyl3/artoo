# ============================================================
# Artoo 部署配置（复制为 .env 后填写）—— 容器部署用
#
# 适用：docker compose / deploy/install.sh（compose 以 env_file 注入到容器）。
# 本地开发不读这里 —— 走 backend/.env.example（直连 localhost）。
#
# 这里只列「需要改」的项。其余 Pipeline 并发、切片、OCR 等都有内置默认值，
# 需要调优时再参考 backend/app/config.py 追加同名大写变量即可（如 PIPELINE_MAX_CONCURRENT）。
#
# 注意：DATABASE_URL / MILVUS_HOST / REDIS_URL 这类容器内连接串由 compose 固定注入，
# 不要在这里配置。
# ============================================================

# ===== 端口与进程 =====
FRONTEND_PORT=8888
BACKEND_PORT=8000
# backend 进程数（uvicorn --workers）。单机约 50 人建议 2，最多 2~4。
BACKEND_WORKERS=2
# PostgreSQL 密码（compose 注入到 postgres 与连接串）
POSTGRES_PASSWORD=postgres
# 时区（影响容器内时间、日志目录按天/小时切分、数据库时间显示）。默认中国标准时间。
TZ=Asia/Shanghai

# ===== 认证（必填，缺失则服务启动失败 fail-fast）=====
# JWT 签名密钥（HS256）。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 下方为示例默认值，生产环境建议重新生成替换。
JWT_SECRET=VAdgoBHl7rmyV6J3YnUsnt6ICxiZCpNtutwFubdcCLPKFF4vDvcrcD8rFpz4TbMc
# 初始超级管理员（首次启动自动创建，强制首次登录改密）
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin123
# 注册模式：invite_only（默认，仅管理员/邀请建号）| self_serve（开放自助注册）
REGISTRATION_MODE=invite_only

# ===== LLM（也可启动后在前端「模型管理」配置）=====
LLM_PROVIDER=vllm
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ===== Embedding 远程服务（填到 /v1，也可在前端配置）=====
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
# 是否启用 Sparse 向量（需服务支持 /embed_sparse 端点）
EMBED_SPARSE_ENABLED=true

# ===== Rerank 远程服务（也可在前端配置）=====
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# ============================================================
# 性能调优（按服务器硬件能力调整；不配则用下方默认值）
# ============================================================
# ---- 数据库连接池（每个进程独立一份）----
# 单进程连接上限 = DB_POOL_SIZE + DB_MAX_OVERFLOW。
# 部署约束：上限 ×（BACKEND_WORKERS + worker 进程数）≤ Postgres max_connections（中间件已设 200）。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 从连接池获取连接的最长等待时间；锁竞争时应快速失败而不是无限堆积
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
# 生产 Compose 由独立 migrate 服务执行迁移；手工/开发运行默认允许启动时自动迁移
AUTO_MIGRATE_ON_STARTUP=false
MIGRATION_LOCK_TIMEOUT_SECONDS=5
MIGRATION_STATEMENT_TIMEOUT_SECONDS=300

# ---- 线程池（承载文档解析/切片、pymilvus 同步检索、bcrypt 等阻塞调用）----
# 0 = Python 默认 min(32, CPU+4)；设正整数则固定上限，CPU 核多可上调。
THREAD_POOL_MAX_WORKERS=0

# ---- Worker 文档处理并发（CPU 多、Embedding 服务能扛则上调）----
# 同时处理的文档数（GPU 推荐 3，CPU 推荐 1-2）
PIPELINE_MAX_CONCURRENT=4
# Embedding 全局并发（所有文档共享，保护远程 Embedding 服务，429 时调小）
PIPELINE_EMBED_CONCURRENCY=6
# 单文档 Embedding 并发上限（必须 < 全局并发，保证多文档交错、小文件不被饿死）
PIPELINE_EMBED_PER_DOC_CONCURRENCY=2
# 每批发给 Embedding 服务的文本数（与 TEI/Infinity 的 max_batch_size 对齐；GPU 64 / CPU 32）
PIPELINE_EMBED_BATCH_SIZE=32
# httpx 连接池上限（须 ≥ MAX_CONCURRENT × EMBED_PER_DOC_CONCURRENCY，否则 PoolTimeout）
PIPELINE_EMBED_MAX_CONNECTIONS=20
# OCR 全局并发（所有文档共享，保护远程 OCR 服务）
PIPELINE_OCR_CONCURRENCY=4
# 大文件分道阈值（MB）：文件 ≥ 此值走慢道，避免占满快道阻塞小文件
PIPELINE_SLOW_LANE_MIN_MB=10
# 慢道在单 Worker 内的最大在途文档数（< MAX_CONCURRENT，给快道留固定额度）
PIPELINE_SLOW_MAX_CONCURRENT=1

# ============================================================
# 知识图谱（knowledge-graph，默认整体关闭，不开零成本）
# ============================================================
# 开启步骤：
#   1) 启动 Neo4j：docker compose --profile infra --profile graph up -d
#      （neo4j 服务挂 profile: graph，不带 --profile graph 时默认不启动）
#   2) 安装驱动：在 backend 镜像/环境额外装 optional extra
#      pip install -r requirements.txt -r requirements-graph.txt
#   3) 把下面 GRAPH_ENABLE 设为 true
#
# 全局总开关：不为 true 则整体关闭（不连 Neo4j、不抽取、API 返回明确不可用）
GRAPH_ENABLE=false
# Neo4j 账号口令（compose 用它生成 neo4j 容器的 NEO4J_AUTH；应用用它连接）。
# 注意：NEO4J_URI 由 compose 固定注入（bolt://neo4j:7687），无需在此配置。
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
# 连接池上限与连接超时（秒）
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONN_TIMEOUT=5
# 单次图查询超时（秒），防恶意 depth/limit
GRAPH_QUERY_TIMEOUT=10
# 抽取慢道并发信号量上限（与文档入库 worker 物理隔离）
GRAPH_EXTRACT_CONCURRENCY=2
# 抽取子任务最大重试次数（超过进 DLQ）
GRAPH_EXTRACT_MAX_RETRIES=3
